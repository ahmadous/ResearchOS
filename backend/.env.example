# --- Flask ---
FLASK_CONFIG=dev
SECRET_KEY=change-me-in-prod
JWT_SECRET_KEY=change-me-in-prod

# Clé Fernet pour chiffrer les clés API stockées (générer en prod) :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=

# --- Base de données ---
# Dev (défaut) : SQLite. Prod : PostgreSQL.
# Supabase : Settings > Database > Connection string (URI), puis remplacer
#   "postgresql://" par "postgresql+psycopg2://" et utiliser le pooler (port 6543)
#   pour un plan gratuit :
#   DATABASE_URL=postgresql+psycopg2://postgres.xxxx:MOTDEPASSE@aws-0-....pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///researchos.db

# --- CORS (prod) ---
# "*" en dev ; en prod, domaine(s) du frontend séparés par des virgules :
# CORS_ORIGINS=https://researchos.vercel.app
CORS_ORIGINS=*

# --- Redis / Celery (Phase 6, optionnel) ---
REDIS_URL=redis://localhost:6379/0
